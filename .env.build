localImage=allfunc/pmvc-phpunit
remoteImage=allfunc/pmvc-phpunit
TERRATEST=allfunc/terratest
VERSION=8.5
# alpine3.22 is no longer rebuilt for PHP 8.5 (last push 2026-06-05, frozen at
# PHP 8.5.4). Keep this on the maintained Alpine line so patch releases land.
ALT_VERSION=fpm-alpine3.23
VER_PREFIX=v
COPY_FILES[]=docker
DOCKER_FILES[]=Dockerfile
